# Settlement Engine Environment Variables
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=5110
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=settlepaisa_v2
DB_USER=postgres
DB_PASSWORD=settlepaisa123

# JWT Authentication
JWT_SECRET=your-secret-key-change-this-in-production

# Logging
LOG_LEVEL=info
SERVICE_NAME=settlement-engine
LOG_DIR=/var/log/ops-dashboard

# Settlement Processing
SETTLEMENT_BATCH_SIZE=500
SETTLEMENT_PROCESSING_INTERVAL_MS=60000

# Bank Transfer API
BANK_API_URL=http://localhost:5102
BANK_API_KEY=your-bank-api-key

# Settlement Limits
MIN_SETTLEMENT_AMOUNT_PAISE=10000
MAX_SETTLEMENT_AMOUNT_PAISE=100000000

# Auto-Approval Threshold (amounts below this are auto-approved)
AUTO_APPROVE_THRESHOLD_PAISE=1000000

# CORS
CORS_ORIGIN=http://localhost:5174
