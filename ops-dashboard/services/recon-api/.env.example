# Recon API Environment Variables
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=5103
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=settlepaisa_v2
DB_USER=postgres
DB_PASSWORD=settlepaisa123

# JWT Authentication (if recon API needs auth)
JWT_SECRET=your-secret-key-change-this-in-production

# Logging
LOG_LEVEL=info
SERVICE_NAME=recon-api
LOG_DIR=/var/log/ops-dashboard

# Reconciliation Engine Settings
RECON_BATCH_SIZE=1000
RECON_TIMEOUT_MS=300000

# File Upload Settings
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_EXTENSIONS=.csv,.xlsx

# CORS
CORS_ORIGIN=http://localhost:5174

# SFTP Configuration for Bank File Retrieval
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USERNAME=sp-sftp
SFTP_PASSWORD=sp-sftp
SFTP_INBOUND_DIR=/inbound

# External API URLs
PG_API_URL=http://localhost:5101
BANK_API_URL=http://localhost:5102
