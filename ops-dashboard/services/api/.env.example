# File Upload API Environment Variables
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=5109
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=settlepaisa_v2
DB_USER=postgres
DB_PASSWORD=settlepaisa123

# JWT Authentication
# ⚠️ CRITICAL: This MUST match the JWT_SECRET in services/overview-api/.env
# All services must use the same JWT_SECRET for authentication to work
# If these don't match, you'll get "Invalid token" errors between services
JWT_SECRET=your-secret-key-change-this-in-production

# Logging
LOG_LEVEL=info
SERVICE_NAME=file-upload-api
LOG_DIR=/var/log/ops-dashboard

# File Upload Settings
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_EXTENSIONS=.csv,.xlsx
UPLOAD_MAX_FILES=10

# CSV Processing
CSV_DELIMITER=,
CSV_ENCODING=utf-8

# CORS
CORS_ORIGIN=http://localhost:5174
