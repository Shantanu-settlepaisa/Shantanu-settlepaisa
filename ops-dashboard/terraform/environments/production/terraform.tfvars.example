# Production Environment Configuration
# Copy this file to terraform.tfvars and fill in actual values
# NEVER commit terraform.tfvars to version control!

# General Configuration
environment  = "production"
project_name = "settlepaisa"
aws_region   = "ap-south-1"

# EC2 Configuration
ec2_instance_type    = "t3.medium"
ec2_key_name         = "settlepaisa-production-key"
ec2_root_volume_size = 50
enable_elastic_ip    = true

# RDS Configuration
rds_instance_class         = "db.t3.large"
rds_engine_version         = "17.6"
rds_allocated_storage      = 100
rds_max_allocated_storage  = 500
rds_storage_type           = "gp3"
rds_database_name          = "settlepaisa_v2"
rds_master_username        = "postgres"
rds_master_password        = "YOUR_RDS_PASSWORD_HERE"  # Replace with actual password
rds_backup_retention_period = 7
rds_backup_window          = "03:00-04:00"
rds_maintenance_window     = "sun:04:00-sun:05:00"
rds_multi_az               = false  # Set to true for HA
rds_publicly_accessible    = false

# S3 Configuration
s3_frontend_bucket_name = "settlepaisa-ops-production"
s3_enable_versioning    = true

# ALB Configuration
alb_name               = "settlepaisa-ops-api-alb"
alb_enable_https       = true
alb_certificate_domain = "api.settlepaisaops.sabpaisa.in"
alb_ssl_policy         = "ELBSecurityPolicy-TLS13-1-2-2021-06"

# Secrets Configuration
jwt_secret              = "YOUR_JWT_SECRET_HERE"  # Replace with actual JWT secret
enable_secrets_manager  = true

# Monitoring Configuration
enable_cloudwatch_alarms  = true
ec2_cpu_alarm_threshold   = 80
rds_cpu_alarm_threshold   = 80
rds_storage_alarm_threshold = 10
alarm_email               = "ops@sabpaisa.in"

# Tags
common_tags = {
  Project     = "SettlePaisa"
  ManagedBy   = "Terraform"
  Environment = "production"
  Repository  = "ops-dashboard"
  Owner       = "DevOps"
}
