# SettlePaisa 2.0 Ops Dashboard - Environment Variables Template
# Copy this file to .env.local for local development
# For staging/production, set these in your deployment environment

# ============================================
# V2 DATABASE CONFIGURATION (Primary)
# ============================================
DB_USER=postgres
DB_HOST=localhost
DB_NAME=settlepaisa_v2
DB_PASSWORD=your_secure_password_here
DB_PORT=5432

# ============================================
# SABPAISA V1 DATABASE (Legacy System)
# ============================================
SABPAISA_DB_USER=settlepaisainternal
SABPAISA_DB_HOST=your_sabpaisa_host
SABPAISA_DB_NAME=sabpaisa_prod
SABPAISA_DB_PASSWORD=your_secure_sabpaisa_password
SABPAISA_DB_PORT=5432

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate using: openssl rand -base64 32
JWT_SECRET=your_256_bit_secret_key_here

# ============================================
# WEBHOOK SECRETS (Payment Gateways)
# ============================================
# Get these from your payment gateway dashboards
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
PAYU_WEBHOOK_SECRET=your_payu_webhook_secret
PAYTM_WEBHOOK_SECRET=your_paytm_webhook_secret

# ============================================
# SETTLEPAISA V1 API CREDENTIALS
# ============================================
SETTLEPAISA_API_KEY=your_api_key
SETTLEPAISA_JWT_TOKEN=your_jwt_token
SETTLEPAISA_STAGING_API_KEY=your_staging_api_key
SETTLEPAISA_STAGING_JWT_TOKEN=your_staging_jwt_token

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5108
LOG_LEVEL=info

# ============================================
# NOTES:
# ============================================
# 1. NEVER commit the actual .env file to git
# 2. Each environment (local, staging, production) should have its own values
# 3. Rotate credentials regularly
# 4. Use strong, randomly generated passwords
